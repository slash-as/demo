{
  "name": "nebula-social-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Nebula — social network PWA demo con SQLite nel browser e backend Neon opzionale",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "build:new": "node scripts/build-new.mjs",
    "preview": "vite preview",
    "db:setup": "node scripts/db-setup.mjs",
    "db:migrate": "node scripts/db-setup.mjs --schema-only",
    "db:seed": "node scripts/db-setup.mjs --seed-only",
    "icons": "pwa-assets-generator --preset minimal-2023 public/logo.svg"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1178.0",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.14.8",
    "@neon/env": "^2.1.11",
    "@neon/functions": "^0.11.0",
    "@neon/realtime": "^0.2.2",
    "hono": "^4.13.22",
    "jose": "^6.2.18",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "@types/sql.js": "^1.4.9",
    "@vite-pwa/assets-generator": "^1.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^1.2.0"
  }
}
